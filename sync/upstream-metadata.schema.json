{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copilot SDK Zig upstream metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "upstreamRepository",
    "upstreamRef",
    "upstreamCommit",
    "sdkProtocolVersion",
    "cliPackageVersion",
    "schemaDigests"
  ],
  "properties": {
    "upstreamRepository": {
      "const": "github/copilot-sdk"
    },
    "upstreamRef": {
      "type": "string",
      "minLength": 1
    },
    "upstreamCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sdkProtocolVersion": {
      "type": "integer",
      "minimum": 0
    },
    "cliPackageVersion": {
      "type": "string",
      "minLength": 1
    },
    "schemaDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api.schema.json",
        "session-events.schema.json"
      ],
      "properties": {
        "api.schema.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "session-events.schema.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
